# Copiá este archivo como .env y completalo.
# Carpetas de facturas, separadas por ;  (tal cual las ves en el explorador de archivos)
CARPETAS=\\192.168.1.254\EqualRP2\Facturas_Conoplas;\\192.168.1.254\EqualRP2\Facturas_Serenplas
# Dirección de la app
APP_URL=https://conoflex-app.vercel.app
# El mismo texto que FACTURAS_TOKEN en el .env del backend
FACTURAS_TOKEN=
# Desde qué fecha leer facturas (la primera vez lee todas desde acá)
DESDE=2025-01-01
# Cada cuántos minutos revisa si hay facturas nuevas
CADA_MINUTOS=5
